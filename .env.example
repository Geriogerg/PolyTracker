# Copy to .env and fill in what you have. Everything is optional.

# true  -> synthetic dataset, no network calls (good first look)
# false -> track Polymarket live
DEMO_MODE=false

# On-chain tracing (funding links, cash-out links, wallet age).
# Free key: https://etherscan.io/myapikey  (Etherscan V2 covers Polygon, chain 137)
ETHERSCAN_API_KEY=
# Alternative provider: set `onchain.provider: blockscout` in config.yaml
BLOCKSCOUT_API_KEY=

# Alerts (either or both)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=

# Where the dashboard is reachable, used for links inside alerts
PUBLIC_URL=http://localhost:8080
WEB_PORT=8080
POSTGRES_PASSWORD=polytracker
